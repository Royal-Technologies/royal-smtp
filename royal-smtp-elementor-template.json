            "title": "📬 Supported Email Providers",
            "title_color": "#2e7d32",
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "em",
              "size": 1.3
            }
          }
        },
        {
          "id": "rs-providers-text",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"color: #3e5a3c; margin-bottom: 15px;\">Connect with your favorite email service in minutes:</p><div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px;\"><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #db4437;\">📧 Gmail</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">OAuth 2.0 & SMTP</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #0078d4;\">📧 Outlook / Office 365</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">OAuth 2.0 & SMTP</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #ff9900;\">📧 Amazon SES</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">API Integration</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #1a82e2;\">📧 SendGrid</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">API Integration</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #d44332;\">📧 Mailgun</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">API Integration</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #0a66c2;\">📧 SMTP.com</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">SMTP Protocol</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #0b996e;\">📧 Brevo (Sendinblue)</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">API Integration</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #ffc107;\">📧 Postmark</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">API Integration</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #fa6423;\">📧 SparkPost</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">API Integration</p></div></div>"
          }
        }
      ]
    },
