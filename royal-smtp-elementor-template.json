              "unit": "em",
              "size": 1.3
            }
          }
        },
        {
          "id": "rs-advantage-list",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<ul style=\"margin: 0; padding-left: 20px; color: #37474f;\"><li style=\"margin-bottom: 10px;\"><strong>Reliable Delivery:</strong> Stop emails from going to spam. Royal SMTP ensures your emails reach the inbox every time.</li><li style=\"margin-bottom: 10px;\"><strong>Easy Setup:</strong> Configure your SMTP in under 5 minutes with our user-friendly wizard and provider-specific guides.</li><li style=\"margin-bottom: 10px;\"><strong>Complete Logging:</strong> Never wonder if an email was sent again. Track all outgoing emails with detailed logs.</li><li style=\"margin-bottom: 10px;\"><strong>Lightweight & Fast:</strong> Optimized code that won't slow down your site. Only loads resources when needed.</li><li style=\"margin-bottom: 10px;\"><strong>100% Free & Open Source:</strong> No premium upsells, no feature locks. Full functionality available for everyone.</li><li style=\"margin-bottom: 0;\"><strong>Developer Friendly:</strong> Clean code, proper hooks, and filters for easy customization.</li></ul>"
          }
        }
      ]
    },
